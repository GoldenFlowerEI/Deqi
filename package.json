{
  "name": "deqi",
  "version": "0.1.0",
  "private": true,
  "description": "Deqi — Golden Flower Emergent Intelligence. Desktop app (v2) + TUI (v1).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run scripts/build-all.mjs",
    "test": "bun run test:desktop ; bun run test:harness",
    "test:desktop": "cd packages/desktop && bun run test --run",
    "test:harness": "node examples/smoke/run-all.mjs",
    "test:all": "node examples/smoke/run-all.mjs --all",
    "typecheck": "bun run scripts/build-all.mjs --noEmit",
    "lint": "eslint .",
    "clean": "bun run scripts/clean-all.mjs",
    "server": "node packages/server/dist/index.js",
    "icons": "node scripts/gen-deqi-icons.mjs",
    "binary:server": "bun build --compile --target=bun-windows-x64 --outfile=binaries/deqi-server-x86_64-pc-windows-msvc.exe packages/server/dist/index.js",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "tauri": "node scripts/tauri.mjs",
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.10.0",
    "eslint": "^9.13.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.11.0",
    "bun-types": "latest"
  }
}
