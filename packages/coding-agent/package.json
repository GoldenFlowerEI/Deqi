{
  "name": "@deqi/coding-agent",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "deqi": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./tools": {
      "types": "./dist/src/tools/index.d.ts",
      "import": "./dist/src/tools/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo no tests yet",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@deqi/ai": "workspace:*",
    "@deqi/agent-core": "workspace:*",
    "@deqi/tui": "workspace:*",
    "@deqi/introspection": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "bun-types": "latest"
  }
