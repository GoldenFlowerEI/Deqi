{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deqi",
  "version": "0.1.0",
  "identifier": "ai.deqi.desktop",
  "build": {
    "beforeDevCommand": "cd ../.. && bun run scripts/dev-desktop.mjs",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../.. && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deqi",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
